<Window
    x:Class="FeatureDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FeatureDeck.Models"
    mc:Ignorable="d"
    Title="FeatureDeck">

    <Grid x:Name="Root" Padding="16,12,16,0" DataContext="{x:Bind ViewModel, Mode=OneTime}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="RefreshButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Uid="RefreshButton" />
                </StackPanel>
            </Button>

            <RadioButtons x:Name="StoreSelector"
                          x:Uid="StoreSelector"
                          Grid.Column="1"
                          MaxColumns="3"
                          SelectedIndex="0"
                          SelectionChanged="StoreSelector_SelectionChanged"
                          VerticalAlignment="Bottom" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Uid="FullResetButton" Click="FullResetButton_Click" />
                <Button x:Uid="FixLkgButton" Click="FixLkgButton_Click" />
            </StackPanel>

            <Button Grid.Column="4"
                    Click="LanguageButton_Click"
                    VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="{x:Bind ViewModel.LanguageToolTip, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            x:Uid="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center" />

            <ComboBox x:Name="FilterBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="FilterBox_SelectionChanged"
                      VerticalAlignment="Center">
                <ComboBoxItem x:Uid="FilterAll" />
                <ComboBoxItem x:Uid="FilterModified" />
                <ComboBoxItem x:Uid="FilterEditable" />
                <ComboBoxItem x:Uid="FilterExperimental" />
                <ComboBoxItem x:Uid="FilterSubscribed" />
            </ComboBox>

            <Button Grid.Column="2" x:Uid="EnableButton" Click="EnableButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="3" x:Uid="DisableButton" Click="DisableButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="4" x:Uid="ResetButton" Click="ResetButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />

            <TextBlock Grid.Column="5"
                       Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Opacity="0.7"
                       FontSize="12" />
        </Grid>

        <Grid Grid.Row="2" Padding="12,6,16,6" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="204" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Uid="ColId" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="1" x:Uid="ColName" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="2" x:Uid="ColPriority" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="3" x:Uid="ColRuntime" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="4" x:Uid="ColBoot" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="5" x:Uid="ColType" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="6" x:Uid="ColVariant" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="7" x:Uid="ColActions" FontWeight="SemiBold" FontSize="12" />
        </Grid>

        <ListView x:Name="FeatureList"
                  Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Filtered, Mode=OneWay}"
                  SelectionMode="Extended"
                  SelectionChanged="FeatureList_SelectionChanged"
                  Padding="0,0,0,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Height" Value="34" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FeatureItem">
                    <Grid Padding="12,0,0,0" BorderThickness="0,0,0,0.5"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="204" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind IdText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind DisplayName}" />
                            <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind Category}" FontSize="10" Opacity="0.85" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasName, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <TextBlock x:Uid="UnnamedLabel" FontSize="10" Opacity="0.6" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding IsImmutable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock x:Uid="ProtectedLabel" FontSize="10" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasSubscriptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock x:Uid="SubscribedLabel" FontSize="10" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind PriorityText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <TextBlock Grid.Column="3" Text="{x:Bind RuntimeStateText}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RuntimeStateText, Converter={StaticResource StateBrushConverter}}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind BootStateText}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding BootStateText, Converter={StaticResource StateBrushConverter}}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind TypeText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />
                        <TextBlock Grid.Column="6" Text="{x:Bind VariantText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Button x:Uid="RowEnable" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowEnable_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                            <Button x:Uid="RowDisable" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowDisable_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                            <Button x:Uid="RowReset" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowReset_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   x:Uid="EmptyHint"
                   Grid.Row="3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ProgressBar x:Name="BusyBar"
                     Grid.Row="3"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Grid.Row="4" Padding="0,8,0,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.75"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.BuildVersionText, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.55"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
