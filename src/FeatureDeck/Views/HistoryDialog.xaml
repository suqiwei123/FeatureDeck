<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FeatureDeck.Views.HistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FeatureDeck.ViewModels"
    mc:Ignorable="d">

    <Grid MinHeight="420"
          MaxHeight="560"
          MinWidth="720"
          ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左列：记录列表 -->
        <Grid Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Uid="HistoryListHeader"
                       FontWeight="SemiBold"
                       FontSize="13" />

            <ListView x:Name="RecordList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRecordItem">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ActionText}" FontWeight="SemiBold" FontSize="13" />
                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="3" Padding="4,1"
                                        Visibility="{x:Bind IsUndone, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind UndoneText}" FontSize="10" />
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        CornerRadius="3" Padding="4,1"
                                        Visibility="{x:Bind IsFailure, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock x:Uid="HistoryFailedBadge" FontSize="10" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{x:Bind SummaryText}"
                                       FontSize="12" Opacity="0.85"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="1"
                       x:Uid="HistoryEmpty"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="240"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Opacity="0.6"
                       Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- 右列：详情 + 撤销 -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.DetailHeaderText, Mode=OneWay}"
                           FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.DetailMetaText, Mode=OneWay}"
                           FontSize="12" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.DetailResultText, Mode=OneWay}"
                           FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="FeedbackBar"
                     Grid.Row="1"
                     IsOpen="False"
                     Message="" />

            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.SelectedChanges, Mode=OneWay}"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryChangeItem">
                        <StackPanel Spacing="2" Padding="0,6"
                                    BorderThickness="0,0,0,0.5"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <TextBlock Text="{x:Bind TitleText}"
                                       FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind SubtitleText}" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{x:Bind RuntimeText}"
                                       FontSize="12" Opacity="0.9"
                                       Visibility="{x:Bind HasRuntime, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind BootText}"
                                       FontSize="12" Opacity="0.9"
                                       Visibility="{x:Bind HasBoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2"
                       x:Uid="HistorySelectHint"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Uid="HistoryRetentionHint"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Grid.Column="1"
                        x:Name="UndoButton"
                        Content="{x:Bind ViewModel.UndoButtonText, Mode=OneWay}"
                        Click="UndoButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
