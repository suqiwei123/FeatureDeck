<Window
    x:Class="ViVeTool.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ViVeTool.GUI.Models"
    mc:Ignorable="d"
    Title="ViVe 图形化工具">

    <Grid x:Name="Root" Padding="16,12,16,0" DataContext="{x:Bind ViewModel, Mode=OneTime}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="RefreshButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <RadioButtons x:Name="StoreSelector"
                          Grid.Column="1"
                          Header="目标存储"
                          MaxColumns="3"
                          SelectedIndex="0"
                          SelectionChanged="StoreSelector_SelectionChanged"
                          VerticalAlignment="Bottom">
                <x:String>运行时</x:String>
                <x:String>启动时</x:String>
                <x:String>两者</x:String>
            </RadioButtons>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="全部还原" Click="FullResetButton_Click" />
                <Button Content="修复启动存储" Click="FixLkgButton_Click" ToolTipService.ToolTip="修复被系统写坏的 Last Known Good 存储头" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            PlaceholderText="搜索特性名称或 ID"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center" />

            <ComboBox x:Name="FilterBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="FilterBox_SelectionChanged"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="全部特性" />
                <ComboBoxItem Content="仅被改过的" />
                <ComboBoxItem Content="仅可修改的" />
                <ComboBoxItem Content="仅实验配置" />
                <ComboBoxItem Content="仅有订阅的" />
            </ComboBox>

            <Button Grid.Column="2" Content="启用" Click="EnableButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="禁用" Click="DisableButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="4" Content="还原" Click="ResetButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalAlignment="Center" />

            <TextBlock Grid.Column="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Opacity="0.7"
                       FontSize="12">
                <Run Text="已选 " /><Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" /><Run Text=" 项（可多选，Ctrl/Shift 加选）" />
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2" Padding="12,6,16,6" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="204" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="1" Text="名称" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="2" Text="优先级" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="3" Text="运行时" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="4" Text="启动时" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="5" Text="类型" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="6" Text="变体" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Grid.Column="7" Text="操作" FontWeight="SemiBold" FontSize="12" />
        </Grid>

        <ListView x:Name="FeatureList"
                  Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Filtered, Mode=OneWay}"
                  SelectionMode="Extended"
                  SelectionChanged="FeatureList_SelectionChanged"
                  Padding="0,0,0,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Height" Value="34" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FeatureItem">
                    <Grid Padding="12,0,0,0" BorderThickness="0,0,0,0.5"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="204" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind IdText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind DisplayName}" />
                            <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind Category}" FontSize="10" Opacity="0.85" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasName, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <TextBlock Text="未命名" FontSize="10" Opacity="0.6" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding IsImmutable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="受保护" FontSize="10" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1"
                                    Visibility="{Binding HasSubscriptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="订阅" FontSize="10" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind PriorityText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <TextBlock Grid.Column="3" Text="{x:Bind RuntimeStateText}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RuntimeStateText, Converter={StaticResource StateBrushConverter}}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind BootStateText}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding BootStateText, Converter={StaticResource StateBrushConverter}}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind TypeText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />
                        <TextBlock Grid.Column="6" Text="{x:Bind VariantText}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.8" />

                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Content="启用" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowEnable_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                            <Button Content="禁用" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowDisable_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                            <Button Content="还原" FontSize="12" Padding="8,2"
                                    Tag="{x:Bind}" Click="RowReset_Click"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="3"
                   Text="没有匹配的特性。试试换个关键词，或切换目标存储。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ProgressBar x:Name="BusyBar"
                     Grid.Row="3"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Grid.Row="4" Padding="0,8,0,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.75"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       FontSize="12"
                       Opacity="0.55"
                       VerticalAlignment="Center">
                <Run Text="Windows 内部版本 " /><Run Text="{x:Bind ViewModel.BuildNumber, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
